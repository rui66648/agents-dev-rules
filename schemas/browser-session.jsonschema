{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Browser Session",
  "description": "浏览器会话配置 - 录制、回放、权限管理",
  "type": "object",
  "required": ["session_id", "target_url", "config"],
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^bs_[a-f0-9]{16}$",
      "description": "浏览器会话唯一标识"
    },
    "target_url": {
      "type": "string",
      "format": "uri",
      "description": "目标 URL"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "创建时间"
    },
    "status": {
      "type": "string",
      "enum": ["created", "connecting", "active", "paused", "ended", "error"],
      "default": "created"
    },
    "config": {
      "type": "object",
      "description": "浏览器配置",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["headless", "headed", "cdp"],
          "description": "浏览器类型"
        },
        "browser": {
          "type": "string",
          "enum": ["chrome", "firefox", "edge"],
          "default": "chrome"
        },
        "viewport": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "default": 1920
            },
            "height": {
              "type": "integer",
              "default": 1080
            }
          }
        },
        "device_scale_factor": {
          "type": "integer",
          "default": 1,
          "description": "设备像素比"
        },
        "is_mobile": {
          "type": "boolean",
          "default": false
        },
        "has_touch": {
          "type": "boolean",
          "default": false
        },
        "user_agent": {
          "type": "string",
          "description": "自定义 User-Agent"
        }
      }
    },
    "permissions": {
      "type": "object",
      "description": "权限配置",
      "properties": {
        "geolocation": {
          "type": "boolean",
          "default": false
        },
        "notifications": {
          "type": "boolean",
          "default": false
        },
        "camera": {
          "type": "boolean",
          "default": false
        },
        "microphone": {
          "type": "boolean",
          "default": false
        },
        "clipboard": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "recording": {
      "type": "object",
      "description": "会话录制配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "format": {
          "type": "string",
          "enum": ["webm", "gif", "png", "json"],
          "default": "webm"
        },
        "quality": {
          "type": "string",
          "enum": ["low", "medium", "high", "original"],
          "default": "medium"
        },
        "fps": {
          "type": "integer",
          "default": 30
        },
        "include_console": {
          "type": "boolean",
          "default": true
        },
        "include_network": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "mcp_config": {
      "type": "object",
      "description": "WebMCP 配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "port": {
          "type": "integer",
          "default": 8080
        },
        "host": {
          "type": "string",
          "default": "127.0.0.1"
        },
        "api_key_env": {
          "type": "string",
          "description": "API Key 环境变量名"
        }
      }
    },
    "proxy": {
      "type": "object",
      "description": "代理配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "server": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "password": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "description": "持久化存储",
      "properties": {
        "cookies": {
          "type": "boolean",
          "default": true
        },
        "local_storage": {
          "type": "boolean",
          "default": true
        },
        "session_storage": {
          "type": "boolean",
          "default": true
        },
        "cache": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "security": {
      "type": "object",
      "description": "安全配置",
      "properties": {
        "ignore_https_errors": {
          "type": "boolean",
          "default": false
        },
        "disable_web_security": {
          "type": "boolean",
          "default": false
        },
        "sandbox": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "元数据",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "examples": [
    {
      "session_id": "bs_a1b2c3d4e5f67890",
      "target_url": "https://example.com",
      "created_at": "2026-08-12T10:00:00Z",
      "status": "active",
      "config": {
        "type": "cdp",
        "browser": "chrome",
        "viewport": {
          "width": 1920,
          "height": 1080
        },
        "is_mobile": false
      },
      "permissions": {
        "geolocation": true,
        "notifications": false
      },
      "recording": {
        "enabled": true,
        "format": "webm",
        "quality": "high",
        "fps": 30
      },
      "mcp_config": {
        "enabled": true,
        "port": 8080
      },
      "security": {
        "ignore_https_errors": false,
        "sandbox": true
      },
      "metadata": {
        "agent_id": "test-agent-001",
        "purpose": "自动化测试",
        "tags": ["test", "automation"]
      }
    }
  ]
}
