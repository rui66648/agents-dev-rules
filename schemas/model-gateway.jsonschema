{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Gateway Configuration",
  "description": "AI 模型网关配置 - 路由策略、缓存、限流、计费",
  "type": "object",
  "required": ["gateway_id", "name", "models", "routing", "cache", "rate_limit"],
  "properties": {
    "gateway_id": {
      "type": "string",
      "pattern": "^gw_[a-z0-9-]+$",
      "description": "网关唯一标识"
    },
    "name": {
      "type": "string",
      "description": "网关名称"
    },
    "description": {
      "type": "string",
      "description": "网关描述"
    },
    "models": {
      "type": "array",
      "description": "支持模型列表",
      "items": {
        "type": "object",
        "required": ["model_id", "provider", "name"],
        "properties": {
          "model_id": {
            "type": "string",
            "description": "模型唯一标识"
          },
          "provider": {
            "type": "string",
            "enum": ["openai", "azure", "anthropic", "google", "local", "cloudflare"],
            "description": "模型提供商"
          },
          "name": {
            "type": "string",
            "description": "模型显示名称"
          },
          "endpoint": {
            "type": "string",
            "description": "API 端点 URL"
          },
          "api_key_env": {
            "type": "string",
            "description": "API Key 环境变量名"
          },
          "pricing": {
            "type": "object",
            "description": "计费信息",
            "properties": {
              "input_token_price": {
                "type": "number",
                "description": "输入 token 单价（每百万）"
              },
              "output_token_price": {
                "type": "number",
                "description": "输出 token 单价（每百万）"
              },
              "currency": {
                "type": "string",
                "default": "USD"
              }
            }
          },
          "limits": {
            "type": "object",
            "description": "速率限制",
            "properties": {
              "max_tokens": {
                "type": "integer",
                "description": "最大 token 数"
              },
              "requests_per_minute": {
                "type": "integer",
                "description": "每分钟请求数限制"
              },
              "concurrent_requests": {
                "type": "integer",
                "description": "并发请求数限制"
              }
            }
          }
        }
      }
    },
    "routing": {
      "type": "object",
      "description": "路由策略配置",
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["round_robin", "weighted", "latency", "cost", "fallback"],
          "description": "路由策略"
        },
        "weights": {
          "type": "object",
          "description": "加权配置（weighted 策略时使用）",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "fallback_chain": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "降级链（fallback 策略时使用）"
        },
        "cost_threshold": {
          "type": "number",
          "description": "成本阈值（超过则切换提供商）"
        },
        "latency_threshold_ms": {
          "type": "integer",
          "description": "延迟阈值（毫秒）"
        }
      }
    },
    "cache": {
      "type": "object",
      "description": "语义缓存配置",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "strategy": {
          "type": "string",
          "enum": ["exact", "similarity", "hybrid"],
          "default": "exact"
        },
        "ttl_seconds": {
          "type": "integer",
          "default": 3600
        },
        "max_size": {
          "type": "integer",
          "description": "缓存最大条目数"
        },
        "similarity_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.95,
          "description": "相似度阈值（similarity/hybrid 策略时使用）"
        }
      }
    },
    "rate_limit": {
      "type": "object",
      "description": "网关级速率限制",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "requests_per_minute": {
          "type": "integer",
          "default": 100
        },
        "tokens_per_minute": {
          "type": "integer",
          "default": 50000
        },
        "burst_size": {
          "type": "integer",
          "default": 10
        },
        "backpressure_strategy": {
          "type": "string",
          "enum": ["reject", "queue", "slow_down"],
          "default": "reject"
        }
      }
    },
    "observability": {
      "type": "object",
      "description": "可观测性配置",
      "properties": {
        "tracing": {
          "type": "boolean",
          "default": true
        },
        "metrics": {
          "type": "boolean",
          "default": true
        },
        "logging": {
          "type": "boolean",
          "default": true
        },
        "log_level": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARNING", "ERROR"],
          "default": "INFO"
        }
      }
    },
    "budget": {
      "type": "object",
      "description": "预算控制",
      "properties": {
        "daily_limit_usd": {
          "type": "number",
          "description": "日预算上限"
        },
        "monthly_limit_usd": {
          "type": "number",
          "description": "月预算上限"
        },
        "alert_threshold_pct": {
          "type": "integer",
          "minimum": 50,
          "maximum": 100,
          "default": 80,
          "description": "告警阈值百分比"
        },
        "action_at_limit": {
          "type": "string",
          "enum": ["alert", "throttle", "stop"],
          "default": "throttle"
        }
      }
    }
  },
  "examples": [
    {
      "gateway_id": "gw_default_001",
      "name": "默认模型网关",
      "description": "主用 AI 模型网关",
      "models": [
        {
          "model_id": "gpt-4",
          "provider": "openai",
          "name": "GPT-4",
          "endpoint": "https://api.openai.com/v1/chat/completions",
          "api_key_env": "OPENAI_API_KEY",
          "pricing": {
            "input_token_price": 0.03,
            "output_token_price": 0.06,
            "currency": "USD"
          }
        },
        {
          "model_id": "claude-3-opus",
          "provider": "anthropic",
          "name": "Claude 3 Opus",
          "endpoint": "https://api.anthropic.com/v1/messages",
          "api_key_env": "ANTHROPIC_API_KEY",
          "pricing": {
            "input_token_price": 0.015,
            "output_token_price": 0.075,
            "currency": "USD"
          }
        }
      ],
      "routing": {
        "strategy": "cost",
        "fallback_chain": ["claude-3-opus", "gpt-4"]
      },
      "cache": {
        "enabled": true,
        "strategy": "exact",
        "ttl_seconds": 3600
      },
      "rate_limit": {
        "enabled": true,
        "requests_per_minute": 60,
        "tokens_per_minute": 30000
      },
      "budget": {
        "daily_limit_usd": 100,
        "monthly_limit_usd": 2000,
        "alert_threshold_pct": 80
      }
    }
  ]
}
