# ==============================================================================
# 开发环境统一端口配置
# ==============================================================================
# 本文档定义了所有开发项目的端口分配，避免端口冲突
# 请复制到各项目的 .env 文件中并根据需要修改
#
# 端口分配原则：
#   - 后端服务使用 8000+ 系列
#   - 前端服务使用 3000+ 系列
#   - 中间件服务使用独立端口（Redis、PostgreSQL 等）
#   - 所有端口均可通过环境变量覆盖
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础设施服务 (Infrastructure)
# ------------------------------------------------------------------------------
# PostgreSQL 数据库
# NOTE: Docker Compose 默认映射到宿主机 5432:5432
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=dev
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=adlc_platform

# Redis 缓存/队列
# NOTE: Docker Compose 默认映射到宿主机 6379:6379
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Qdrant 向量数据库 (OmniRoute 可选)
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ------------------------------------------------------------------------------
# 2. ADLC 平台 (src/)
# ------------------------------------------------------------------------------
# 后端 FastAPI 服务
ADLC_BACKEND_HOST=0.0.0.0
ADLC_BACKEND_PORT=8000

# 前端 React/Vite 服务
ADLC_FRONTEND_HOST=0.0.0.0
ADLC_FRONTEND_PORT=3000
ADLC_FRONTEND_API_BASE_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# 3. Trae LLM Gateway (trae-llm-gateway/)
# ------------------------------------------------------------------------------
# LiteLLM 网关自身
LITELLM_MASTER_KEY=sk-change-me-to-random-string
LITELLM_PORT=4000

# Smart Proxy 统一入口
SMART_PROXY_PORT=4000

# API Keys (请替换为真实密钥)
ZHIPU_API_KEY=your-zhipu-key-here
NVIDIA_API_KEY=your-nvidia-key-here
MODELSCOPE_API_KEY=your-modelscope-key-here
AGNES_API_KEY=your-agnes-key-here

# LiteLLM 限流配置
NIM_DEFAULT_RPM=40
KEY_COOLDOWN_SECONDS=60
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=60

# ------------------------------------------------------------------------------
# 4. FreeLLMAPI (freellmapi/)
# ------------------------------------------------------------------------------
# Node.js 代理服务
FREEAPI_HOST=0.0.0.0
FREEAPI_PORT=3001

# 加密密钥 (请生成随机密钥)
# 生成命令: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# 代理速率限制
PROXY_RATE_LIMIT_RPM=120
ADMIN_RATE_LIMIT_RPM=600

# 请求分析保留策略
REQUEST_ANALYTICS_RETENTION_DAYS=90
REQUEST_ANALYTICS_MAX_ROWS=100000

# ------------------------------------------------------------------------------
# 5. OmniRoute (omniroute/)
# ------------------------------------------------------------------------------
# OmniRoute 主服务
OMNIROUTE_HOST=0.0.0.0
OMNIROUTE_PORT=20128
OMNIROUTE_DASHBOARD_PORT=20128
OMNIROUTE_API_PORT=20129
OMNIROUTE_BASE_PATH=

# WebSocket 实时推送
OMNIROUTE_LIVE_WS_PORT=20132
OMNIROUTE_LIVE_WS_HOST=0.0.0.0
OMNIROUTE_LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128

# CLIProxyAPI Sidecar (可选)
CLIPROXYAPI_PORT=8317

# Bifrost LLM 路由 Sidecar (可选)
BIFROST_PORT=8080
BIFROST_ENABLED=false

# Redis 连接 (与基础设施共用)
OMNIROUTE_REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 6. 端口汇总
# ------------------------------------------------------------------------------
# 服务名称                    | 宿主机端口 | 内部端口 | 协议
# --------------------------- | ---------- | -------- | ----
# PostgreSQL                  | 5432       | 5432     | TCP
# Redis                       | 6379       | 6379     | TCP
# Qdrant                      | 6333       | 6333     | TCP
# Qdrant gRPC                 | 6334       | 6334     | TCP
# ADLC Backend                | 8000       | 8000     | HTTP
# ADLC Frontend               | 3000       | 3000     | HTTP
# FreeLLMAPI                  | 3001       | 3001     | HTTP
# Trae LLM Gateway            | 4000       | 4000     | HTTP
# OmniRoute Dashboard         | 20128      | 20128    | HTTP
# OmniRoute API               | 20129      | 20129    | HTTP
# OmniRoute WebSocket         | 20132      | 20132    | WS
# Bifrost (可选)              | 8080       | 8080     | HTTP
# CLIProxyAPI (可选)          | 8317       | 8317     | HTTP
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 7. 使用说明
# ------------------------------------------------------------------------------
#
# 1. 复制此文件为各项目的 .env 文件：
#    cp .env.template src/.env
#    cp .env.template trae-llm-gateway/.env
#    cp .env.template freellmapi/.env
#    cp .env.template omniroute/.env
#
# 2. 根据项目需求修改相应的配置项
#
# 3. 确保所有 API Keys 已替换为真实值
#
# 4. 如需修改端口，只需更改对应环境变量即可
#
# ==============================================================================
