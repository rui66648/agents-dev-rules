  "shadcn_registry": {
    "description": "shadcn/ui 组件元数据（从 registry 获取，与 uiverse.io 互补）",
    "base_components": [
      {
        "name": "Button",
        "variants": [
          "primary",
          "secondary",
          "destructive",
          "outline",
          "ghost",
          "link"
        ],
        "usage": "所有交互按钮的基础组件",
        "forbidden": [
          " destroy 操作必须用 destructive variant",
          "导航应使用 link variant 或 <a> 标签"
        ],
        "depth_limit": 1,
        "per_screen_limits": {
          "max_primary": 1,
          "max_destructive_per_action_group": 1
        },
        "required_in": [
          "list_page",
          "detail_page",
          "form_page",
          "settings_page",
          "dashboard_page",
          "error_page"
        ],
        "optional_in": [],
        "examples": {
          "correct": [
            "<Button variant='primary'>提交表单</Button>",
            "<Button variant='destructive'>删除账户</Button>",
            "<Button variant='link' asChild><a href='/home'>返回首页</a></Button>"
          ],
          "incorrect": [
            "<Button variant='primary'>删除账户</Button> // destructive 应用 destructive variant",
            "<Button variant='link'>点击这里</Button> // 导航应使用 <a> 标签"
          ]
        }
      },
      {
        "name": "Card",
        "structure": [
          "CardHeader",
          "CardTitle",
          "CardDescription",
          "CardContent",
          "CardFooter"
        ],
        "usage": "内容区块容器，必须含 Header+Body",
        "forbidden": [
          "嵌套 Card（Card 内不再套 Card）",
          "Card 内套 Modal/Drawer（应扁平化）",
          "无 Header 的 Card（必须有标题）"
        ],
        "depth_limit": 1,
        "per_screen_limits": {
          "max_card_depth": 3,
          "max_cards_per_screen": 12
        },
        "required_in": [
          "dashboard_page",
          "detail_page"
        ],
        "optional_in": [
          "list_page",
          "settings_page"
        ],
        "examples": {
          "correct": [
            "<Card><CardHeader><CardTitle>用户信息</CardTitle></CardHeader><CardContent>详情内容</CardContent></Card>",
            "<Card><CardHeader><CardTitle>统计卡片</CardTitle></CardHeader><CardContent><StatChart /></CardContent></Card>"
          ],
          "incorrect": [
            "<Card><CardContent>无 Header</CardContent> // 必须有 CardHeader",
            "<Card><CardHeader>外</CardHeader><CardContent><Card>内</Card></CardContent></Card> // 禁止 Card 嵌套"
          ]
        }
      },
      {
        "name": "Modal",
        "usage": "需要阻断用户操作的确认/录入场景",
        "forbidden": [
          "嵌套 Modal（Modal 内不能再开 Modal）",
          "长表单应使用 Drawer 而非 Modal",
          "非阻断操作不应使用 Modal"
        ],
        "depth_limit": 2,
        "per_screen_limits": {
          "max_modal_depth": 2,
          "note": "Modal 内最多再套 1 层 Drawer"
        },
        "required_in": [],
        "optional_in": [
          "list_page",
          "detail_page",
          "form_page"
        ],
        "examples": {
          "correct": [
            "<Modal title='确认删除'><ModalContent>确定删除此项目？</ModalContent><ModalFooter><Button variant='destructive'>删除</Button></ModalFooter></Modal>",
            "<Modal title='编辑信息'><Form /> // 短表单可用 Modal</Modal>"
          ],
          "incorrect": [
            "<Modal title='设置'><Modal><ModalTitle>嵌套 Modal</ModalTitle></Modal></Modal> // 禁止嵌套 Modal",
            "<Modal title='复杂表单'><LongForm /></Modal> // 长表单应使用 Drawer"
          ]
        }
      },
      {
        "name": "Drawer",
        "usage": "侧边录入/配置面板，替代 Modal 处理复杂表单",
        "forbidden": [
          "嵌套 Drawer（Drawer 内不能再开 Drawer）",
          "简单确认操作应使用 Modal 而非 Drawer"
        ],
        "depth_limit": 2,
        "per_screen_limits": {
          "max_drawer_depth": 2
        },
        "required_in": [],
        "optional_in": [
          "form_page",
          "settings_page",
          "detail_page"
        ],
        "examples": {
          "correct": [
            "<Drawer title='编辑用户'><UserForm /><DrawerFooter><Button>保存</Button></DrawerFooter></Drawer>",
            "<Drawer><SettingsForm /></Drawer> // 复杂配置用 Drawer"
          ],
          "incorrect": [
            "<Drawer title='确认'><Drawer><Drawer title='嵌套'>内层</Drawer></Drawer></Drawer> // 禁止嵌套 Drawer",
            "<Drawer title='简单确认'><Button>是</Button></Drawer> // 简单操作应用 Modal"
          ]
        }
      },
      {
        "name": "DataTable",
        "usage": "结构化数据展示，支持排序/筛选/分页/选择",
        "forbidden": [
          "单条数据展示（应使用 DetailCard）",
          "非结构化内容（应用 Card 而非 Table）"
        ],
        "depth_limit": 1,
        "per_screen_limits": {
          "max_rows_visible": 20,
          "note": "超过 20 行必须启用分页"
        },
        "required_in": [
          "list_page"
        ],
        "optional_in": [
          "dashboard_page"
        ],
        "examples": {
          "correct": [
            "<DataTable columns={columns} data={users} pagination={<Pagination />} />",
            "<DataTable filter={<FilterBar />} sort={handleSort} />"
          ],
          "incorrect": [
            "<DataTable><SingleUserCard /></DataTable> // 单条数据应用 DetailCard",
            "<DataTable><BlogPost /></DataTable> // 非结构化内容应用 Card"
          ]
        }
      },
      {
        "name": "FilterBar",
        "usage": "列表页的筛选条件区，支持 sticky 定位",
        "forbidden": [
          "详情页使用（应使用 Tabs 组织信息）",
          "表单页使用（应使用 Form 字段）"
        ],
        "depth_limit": 1,
        "per_screen_limits": {},
        "required_in": [
          "list_page"
        ],
        "optional_in": [],
        "examples": {
          "correct": [
            "<FilterBar><Select /><Input /><DatePicker /></FilterBar>",
            "<FilterBar sticky><SearchInput /></FilterBar> // 支持 sticky 定位"
          ],
          "incorrect": [
            "<FilterBar>详情页</FilterBar> // 详情页应用 Tabs",
            "<FilterBar><Form /></FilterBar> // 表单页应用 Form 字段"
          ]
        }
      },
      {
        "name": "Pagination",
        "usage": "大数据量列表的分页控件",
        "forbidden": [],
        "depth_limit": 1,
        "per_screen_limits": {},
        "required_in": [
          "list_page"
        ],
        "optional_in": [
          "dashboard_page"
        ],
        "examples": {
          "correct": [
            "<Pagination total={100} pageSize={20} />"
          ],
          "incorrect": [
            "<Pagination total={5} /> // 数据不足一页不应显示分页"
          ]
        }
      },
      {
        "name": "Tabs",
        "usage": "互斥的信息分组展示",
        "forbidden": [
          "嵌套 Tabs（TabPanel 内不再套 Tabs）",
          "作为主要导航（应用 Sidebar/Nav）"
        ],
        "depth_limit": 1,
        "per_screen_limits": {
          "max_tabs": 8,
          "note": "超过 8 个 tab 应考虑折叠或分页"
        },
        "required_in": [],
        "optional_in": [
          "detail_page",
          "settings_page",
          "dashboard_page"
        ],
        "examples": {
          "correct": [
            "<Tabs defaultValue='info'><TabsList><TabsTrigger>信息</TabsTrigger></TabsList><TabsContent>详情</TabsContent></Tabs>",
            "<Tabs><TabsList><TabsTrigger>基础</TabsTrigger><TabsTrigger>高级</TabsTrigger></TabsList></Tabs>"
          ],
          "incorrect": [
            "<Tabs><Tabs><TabPanel>嵌套 Tabs</TabPanel></Tabs></Tabs> // 禁止嵌套 Tabs",
            "<Tabs><TabsTrigger>首页</TabsTrigger></Tabs> // 主要导航应用 Sidebar"
          ]
        }
      },
      {
        "name": "EmptyState",
        "usage": "数据为空时的占位展示",
        "forbidden": [],
        "depth_limit": 0,
        "per_screen_limits": {},
        "required_in": [
          "list_page",
          "dashboard_page"
        ],
        "optional_in": [
          "detail_page"
        ],
        "examples": {
          "correct": [
            "<EmptyState icon='inbox' title='暂无数据'><Button>创建第一条</Button></EmptyState>",
            "<EmptyState description='请先添加筛选条件' />"
          ],
          "incorrect": [
            "<EmptyState><DataTable /></EmptyState> // EmptyState 不应包含数据组件",
            "<EmptyState /> // 必须有 title 或 description"
          ]
        }
      },
      {
        "name": "Skeleton",
        "usage": "加载态占位（替代 spinner 用于大面积加载）",
        "forbidden": [
          "小范围加载（应使用 spinner）",
          "已知内容的骨架屏（避免误导用户）"
        ],
        "depth_limit": 0,
        "per_screen_limits": {},
        "required_in": [
          "list_page",
          "detail_page",
          "dashboard_page"
        ],
        "optional_in": [],
        "examples": {
          "correct": [
            "<Skeleton className='h-4 w-3/4' /><Skeleton className='h-10 w-full' />",
            "<SkeletonCard /><SkeletonTable /> // 大面积加载用 Skeleton"
          ],
          "incorrect": [
            "<Spinner /> // 小范围加载应使用 spinner",
            "<Skeleton>{已知内容}</Skeleton> // 已知内容不应显示骨架屏"
          ]
        }
      }
    ]
  },
  "validation_rules": {
    "component_name_must_exist": "AI 生成的组件名必须在 catalog 中，否则打回重生成",
    "depth_check": "递归检查 JSX 树，嵌套深度不得超过组件定义的 depth_limit",
    "primary_button_count": "每页面 primary variant Button 不得超过 per_screen_limits.max_primary",
    "forbidden_combination": "检查 forbidden 数组中定义的组合，命中则阻断",
    "token_consistency": "颜色/间距必须使用设计令牌（design tokens），禁止裸 hex 值"
  }
}