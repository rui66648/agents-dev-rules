{
  "version": "2.0.0",
  "source": "uiverse.io + shadcn/ui registry",
  "license": "MIT",
  "updated": "2026-08-27",
  "description": "组件库元数据（机器可读），供 AI 选型校验。每个组件包含 usage/forbidden/depth_limit/per_screen_limits， RULE-035 强制引用。",
  "schema_version": "2.0.0",
  "metadata_fields": {
    "usage": "字符串，说明何时使用该组件（业务语义）",
    "forbidden": "数组，说明何时禁止使用该组件（负面规则）",
    "depth_limit": "整数，最大嵌套深度（0=容器，1=普通，2=Modal/Drawer内）",
    "per_screen_limits": "对象，每屏限制（如 max_primary_buttons: 1）",
    "required_in": "数组，该组件必须出现在哪些页面模板中",
    "optional_in": "数组，该组件可出现在哪些页面模板中"
  },
  "categories": [
    {
      "name": "buttons",
      "label": "按钮 Buttons",
      "components": [
        {
          "name": "fly-arrow-button",
          "title": "Fly Arrow Button",
          "author": "adamgiebl",
          "source": "uiverse.io/adamgiebl/smart-moth-68",
          "file": "buttons/fly-arrow-button.html",
          "dependencies": [],
          "views": "111K",
          "description": "带飞行动画箭头的按钮",
          "usage": "C 端营销页的 CTA 按钮，需要动效吸引注意力",
          "forbidden": [
            "B 端后台管理页的主操作按钮",
            "表单提交按钮（动效干扰用户操作）",
            "删除/销毁操作的确认按钮"
          ],
          "depth_limit": 1,
          "per_screen_limits": {
            "max_animated_buttons": 2,
            "note": "动效按钮过多影响性能与可访问性"
          },
          "required_in": [],
          "optional_in": [
            "landing_page",
            "marketing_page"
          ],
          "examples": {
            "correct": [
              "<Button variant='ghost' onClick={handleClick}>了解更多</Button>"
            ],
            "incorrect": [
              "<Button variant='primary' className='animate-bounce'>点击我</Button>"
            ]
          },
          "_category": "buttons"
        },
        {
          "name": "delete-expand-button",
          "title": "Delete Expand Button",
          "author": "vinodjangid07",
          "source": "uiverse.io/vinodjangid07/smart-emu-83",
          "file": "buttons/delete-expand-button.html",
          "dependencies": [],
          "views": "45K",
          "favorites": "5.2K",
          "description": "展开确认删除的按钮",
          "usage": "需要二次确认的删除操作，防误触",
          "forbidden": [
            "不可逆的毁灭性操作（应走 Modal 确认）",
            "高频操作按钮（展开动画影响效率）"
          ],
          "depth_limit": 1,
          "per_screen_limits": {
            "max_expand_buttons": 1,
            "note": "同页面多个展开式删除按钮会造成混乱"
          },
          "required_in": [],
          "optional_in": [
            "list_page",
            "detail_page"
          ],
          "examples": {
            "correct": [
              "<DeleteExpandButton onConfirm={handleDelete} />"
            ],
            "incorrect": [
              "<DeleteExpandButton onConfirm={handlePermanentDelete} /> // 不可逆毁灭操作应走 Modal 确认"
            ]
          },
          "_category": "buttons"
        },
        {
          "name": "social-icons-grid",
          "title": "Social Icons Grid",
          "author": "Praashoo7",
          "source": "uiverse.io/Praashoo7/smooth-crab-52",
          "file": "buttons/social-icons-grid.html",
          "dependencies": [],
          "views": "69K",
          "favorites": "6K",
          "description": "社交媒体图标网格",
          "usage": "页脚社交链接、分享区域",
          "forbidden": [
            "主导航中的功能图标（应用 Lucide 等语义化图标）",
            "操作按钮（应使用 Button 组件）"
          ],
          "depth_limit": 0,
          "per_screen_limits": {},
          "required_in": [],
          "optional_in": [
            "landing_page",
            "footer"
          ],
          "examples": {
            "correct": [
              "<footer><SocialIconsGrid links={socialLinks} /></footer>"
            ],
            "incorrect": [
              "<nav><SocialIconsGrid links={toolLinks} /></nav> // 主导航功能图标应使用 Lucide"
            ]
          },
          "_category": "buttons"
        }
      ]
    },
    {
      "name": "tooltips",
      "label": "提示 Tooltips",
      "components": [
        {
          "name": "faq-tooltip-button",
          "title": "FAQ Tooltip Button",
          "author": "vinodjangid07",
          "source": "uiverse.io/vinodjangid07/funny-panther-79",
          "file": "tooltips/faq-tooltip-button.html",
          "dependencies": [],
          "views": "13K",
          "favorites": "810",
          "description": "带 FAQ 提示的按钮",
          "usage": "复杂字段或专业术语旁的帮助提示",
          "forbidden": [
            "主要操作按钮（分散用户注意力）",
            "移动端触摸区域（tooltip 不可靠）"
          ],
          "depth_limit": 1,
          "per_screen_limits": {
            "max_tooltips_per_section": 5,
            "note": "过多 tooltip 造成认知负担"
          },
          "required_in": [],
          "optional_in": [
            "form_page",
            "settings_page",
            "detail_page"
          ],
          "examples": {
            "correct": [
              "<FieldLabel>什么是 XX？<FaqTooltipButton content='冒号后的释义' /></FieldLabel>"
            ],
            "incorrect": [
              "<button className='primary'><FaqTooltipButton>帮助</FaqTooltipButton></button> // 主操作按钮装 tooltip"
            ]
          },
          "_category": "tooltips"
        }
      ]
    },
    {
      "name": "cards",
      "label": "卡片 Cards",
      "components": [
        {
          "name": "glassmorphism-card",
          "title": "Glassmorphism Card",
          "author": "monkey_8812",
          "source": "uiverse.io/monkey_8812/curly-moth-56",
          "file": "cards/glassmorphism-card.html",
          "dependencies": [
            "tailwindcss@2.2.19 (CDN)"
          ],
          "views": "24K",
          "favorites": "916",
          "description": "毛玻璃效果卡片，依赖 Tailwind CSS",
          "usage": "C 端 landing page 的特色内容展示卡片",
          "forbidden": [
            "B 端后台表格内的数据卡片（性能差）",
            "暗色模式未适配前不得使用",
            "WCAG 对比度 < 4.5:1 的内容载体"
          ],
          "depth_limit": 1,
          "per_screen_limits": {
            "max_glass_cards_per_screen": 3,
            "note": "毛玻璃效果过多影响性能与可读性"
          },
          "required_in": [],
          "optional_in": [
            "landing_page",
            "dashboard_page"
          ],
          "examples": {
            "correct": [
              "<div className='backdrop-blur-md bg-white/10 border border-white/20'>特色内容</div>"
            ],
            "incorrect": [
              "<div className='backdrop-blur-md'>暗色模式未适配</div>"
            ]
          },
          "_category": "cards"
        },
        {
          "name": "code-editor-card",
          "title": "Code Editor Card",
          "author": "Yaya12085",
          "source": "uiverse.io/Yaya12085/ugly-mule-59",
          "file": "cards/code-editor-card.html",
          "dependencies": [],
          "views": "27K",
          "favorites": "",
          "description": "代码编辑器风格卡片",
          "usage": "展示代码片段、技术文档、API 示例",
          "forbidden": [
            "业务数据展示（应使用 DataTable/DetailCard）",
            "移动端主要展示区域"
          ],
          "depth_limit": 1,
          "per_screen_limits": {},
          "required_in": [],
          "optional_in": [
            "docs_page",
            "landing_page",
            "dashboard_page"
          ],
          "examples": {
            "correct": [
              "<CodeEditorCard language='typescript'><pre>{\n  code: 'example'\n}</pre></CodeEditorCard>"
            ],
            "incorrect": [
              "<CodeEditorCard>{userData.name}</CodeEditorCard>"
            ]
          },
          "_category": "cards"
        }
      ]
    },
    {
      "name": "loaders",
      "label": "加载器 Loaders",
      "components": [
        {
          "name": "simple-css-spinner",
          "title": "Simple CSS Spinner",
          "author": "Fernando-sv",
          "source": "uiverse.io/Fernando-sv/quiet-zebra-41",
          "file": "loaders/simple-css-spinner.html",
          "dependencies": [],
          "views": "25K",
          "favorites": "675",
          "description": "纯 CSS 旋转加载器",
          "usage": "局部加载态（单组件级 loading）",
          "forbidden": [
            "全局加载态（应使用 ScreenLoader 或 Skeleton）",
            "长时间等待场景（>3s 应显示进度条）"
          ],
          "depth_limit": 0,
          "per_screen_limits": {
            "max_concurrent_spinners": 3,
            "note": "多个 spinner 同时旋转影响性能"
          },
          "required_in": [],
          "optional_in": [
            "list_page",
            "detail_page",
            "form_page"
          ],
          "examples": {
            "correct": [
              "<div aria-label='加载中'><SimpleCssSpinner /></div>"
            ],
            "incorrect": [
              "<SimpleCssSpinner /> // 大面积加载应使用 Skeleton，长任务应显示进度条"
            ]
          },
          "_category": "loaders"
        },
        {
          "name": "path-morphing-loader",
          "title": "Path Morphing Loader",
          "author": "mobinkakei",
          "source": "uiverse.io/mobinkakei/proud-ladybug-46",
          "file": "loaders/path-morphing-loader.html",
          "dependencies": [],
          "views": "39K",
          "favorites": "1.4K",
          "description": "路径变形加载器",
          "usage": "品牌感强的 landing page 首屏加载",
          "forbidden": [
            "B 端后台加载（过于花哨，影响专业感）",
            "移动端低性能设备（SVG 动画开销大）"
          ],
          "depth_limit": 0,
          "per_screen_limits": {
            "max_morphing_loaders": 1,
            "note": "变形动画只能有一个，避免视觉混乱"
          },
          "required_in": [],
          "optional_in": [
            "landing_page"
          ],
          "examples": {
            "correct": [
              "<PathMorphingLoader />"
            ],
            "incorrect": [
              "<PathMorphingLoader /> // B端后台应使用简单 spinner"
            ]
          },
          "_category": "loaders"
        }
      ]
    },
    {
      "name": "toggle-switches",
      "label": "开关 Toggle Switches",
      "components": [
        {
          "name": "3d-toggle-switch",
          "title": "3D Toggle Switch",
          "author": "EddyBel",
          "source": "uiverse.io/EddyBel/slimy-penguin-36",
          "file": "toggle-switches/3d-toggle-switch.html",
          "dependencies": [],
          "views": "",
          "description": "带 3D 透视动画和径向渐变背景的开关",
          "usage": "设置页的开关控件，需要视觉反馈的场景",
          "forbidden": [
            "表单内的基础开关（应使用 shadcn/ui Switch）",
            "高频操作开关（动画影响操作效率）",
            "WCAG 对比度不达标的环境"
          ],
          "depth_limit": 1,
          "per_screen_limits": {
            "max_3d_toggles": 2,
            "note": "3D 开关过多影响性能与可访问性"
          },
          "required_in": [],
          "optional_in": [
            "settings_page",
            "form_page"
          ],
          "examples": {
            "correct": [
              "<ThreeDToggleSwitch checked={enabled} onCheckedChange={setEnabled} />"
            ],
            "incorrect": [
              "<ThreeDToggleSwitch /> // 高频开关应使用基础 Switch"
            ]
          },
          "_category": "toggle-switches"
        }
      ]
    },
