  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "stylelint": "^16.10.0",
    "eslint-plugin-design-tokens": "^1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
