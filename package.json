{
  "name": "agents-dev-rules",
  "version": "4.22.0",
  "description": "面向 AI 编码代理的开发流程规则仓库：规则正文、技能 SOP、确定性门禁",
  "license": "Apache-2.0",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/rui66648/agents-dev-rules.git"
  },
  "homepage": "https://github.com/rui66648/agents-dev-rules#readme",
  "bugs": {
    "url": "https://github.com/rui66648/agents-dev-rules/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "workflow",
    "rules",
    "guardrails"
  ],
  "files": [
    "rules",
    "skills",
    "commands",
    "agents",
    "hooks",
    "templates",
    "schemas"
  ],
  "scripts": {
    "lint:tokens": "node hooks/design-token-linter.js",
    "lint:eslint-config": "node --check .eslintrc.schema-as-code.js",
